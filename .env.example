# ============ قاعدة البيانات (PostgreSQL + Drizzle) ============
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ============ الموقع ============
# الرابط العام للموقع (يُستخدم في SEO / OpenGraph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============ (اختياري للإنتاج) تكاملات خارجية ============
# تخزين الوسائط — عند الإنتاج اربط Cloudinary بنفس واجهة الرفع
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# إرسال كود OTP عبر SMS (Twilio Verify) — في المعاينة يُعرض الكود داخل الواجهة
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# البريد الترحيبي (Resend)
RESEND_API_KEY=""
RESEND_FROM="Funoon <no-reply@funoon.art>"

# تسجيل الدخول عبر Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
